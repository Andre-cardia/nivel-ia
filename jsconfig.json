{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022"
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.d.ts", "tests/**/*.js"],
  "exclude": ["dist", "node_modules", ".aiox-core"]
}
